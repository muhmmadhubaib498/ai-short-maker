rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 1. User video projects and raw uploads up to 2GB (2048MB)
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'muhmmadhubaib498@gmail.com');
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'muhmmadhubaib498@gmail.com')
                   && request.resource.size < 2048 * 1024 * 1024;
    }

    // 2. Direct client-side video uploads directory up to 2GB
    match /uploads/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'muhmmadhubaib498@gmail.com');
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'muhmmadhubaib498@gmail.com')
                   && request.resource.size < 2048 * 1024 * 1024;
    }

    // 3. Fallback for authenticated users up to 2GB
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 2048 * 1024 * 1024;
    }
  }
}
